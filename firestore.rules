        && d.type in ['Assignment', 'Quiz', 'Midterm', 'M Assignment', 'M Quiz', 'M Midterm', 'M Project']
        && (!('courseCode' in d) || (d.courseCode is string && d.courseCode.size() <= 40))
        && (!('description' in d) || (d.description is string && d.description.size() <= 1000))
