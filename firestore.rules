        && (!('closesAt' in d) || d.closesAt == null || (d.closesAt is timestamp && d.closesAt >= d.deadline))
=======
        && d.deadline is timestamp && d.closesAt is timestamp && d.closesAt >= d.deadline
>>>>>>> 366e725f73194c64e6d2e453fbcd1bee15829fc2
        && d.published is bool
        && validAttachments(d.attachments)
        && d.updatedAt == request.time;
    }

    match /submissions/{id} {
      // Anyone (signed in or not) may read PUBLISHED records. Drafts / unpublished records are readable by admins only.
      // Queries from the public site therefore must filter on published == true (the site does).
      allow get, list: if isAdmin() || resource.data.published == true;

      allow create: if isAdmin()
        && validSubmission(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        && validSubmission(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
